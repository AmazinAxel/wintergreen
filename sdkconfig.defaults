CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# DIO, not QIO — QIO does not boot on the X4. See CLAUDE.md before changing.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# FAT Long File Name support for .epub filenames
CONFIG_FATFS_LFN_HEAP=y

# Build a per-file cluster-link map so fseek() stays in RAM instead of
# re-traversing the FAT chain on every random access. ~29% faster conversion.
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_USE_LABEL=y

# Codepage 437, not dynamic — dynamic costs 478 KB of flash. See CLAUDE.md.
CONFIG_FATFS_CODEPAGE_437=y

# Main task needs enough stack for EPUB parsing (ZIP + XML + CSS) and
# for FatFS/SDSPI calls inside settings flows (clear cache, etc).
# IDF default is 3584 which is far too tight.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Note: automatic light sleep (CONFIG_PM_ENABLE + FREERTOS_USE_TICKLESS_IDLE) is
# deliberately absent — it breaks the ADC-ladder buttons. See CLAUDE.md "Idle power".

# --- Boot speed ---
# Deep-sleep wake is a full boot here, so anything on the boot path runs on every
# single wake. Battery life comes from making wake cheap enough that a short
# kAutoSleepMinutes is tolerable. See CLAUDE.md "Idle power".

# Don't re-verify the app image SHA-256 when waking from deep sleep — that reads
# and hashes the whole image every time. Cold boot still validates, so genuine
# flash corruption is still caught on power-on. Revisit if OTA is ever added.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# No bootloader console output: ~900 characters at 115200 baud is ~78 ms of
# every boot, spent entirely on log lines nobody reads.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0

# RTC_SLOW_CLK calibration runs at every startup; 1024 cycles of a 150 kHz clock
# is ~6.8 ms. Its precision only matters for timer-based deep-sleep wake, and we
# wake on GPIO, so this is accuracy we never spend.
CONFIG_RTC_CLK_CAL_CYCLES=256

# --- Logging ---
# Silent by default so no boot time goes into UART, but still *compiled in*:
# flash is not scarce (~4.7 MB free in app0) and esp_log_level_set() can turn any
# tag back on at runtime. Compiling logging out would save flash we don't need
# and cost the ability to debug a device that is misbehaving in the field.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0

# --- Dead weight ---
# Error-code-to-string table, and JTAG-debugger awareness checks on every
# assert/abort path. Neither is reachable in a shipped build.
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_ESP_DEBUG_OCDAWARE=n
CONFIG_FREERTOS_DEBUG_OCDAWARE=n

# RAM optimizations
# Optimize for performance (-O2) — faster CPU-bound inflate/XML parsing
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n

# Silent assertions: keeps the check, drops the file/line/message strings from
# flash. HAL follows the system level, so setting HAL alone had no effect.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Use newlib nano printf
CONFIG_NEWLIB_NANO_FORMAT=y

# Move FreeRTOS functions to flash (slightly slower, saves IRAM)
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# Use SPI flash ROM implementation (saves IRAM by using ROM code)
CONFIG_SPI_FLASH_ROM_IMPL=y

# Reduce ISR stack (default 1536, we have no heavy ISRs)
CONFIG_FREERTOS_ISR_STACKSIZE=1024

# Move heap allocator (tlsf) from IRAM to flash — saves ~3.5KB IRAM
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# SPI master/slave ISR in flash — we don't do SPI during flash writes
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n

# No need to post events from IRAM ISR context
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n

# Reduce HAL assertions (silent = no format strings in IRAM)
CONFIG_HAL_DEFAULT_ASSERTION_LEVEL=1

# Move libc lock functions to flash
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n

# --- Internal task stack reductions (heap savings) ---
# We don't use esp_timer callbacks or event loops heavily
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048
